# Plugins installés par vim-plug (propres à chaque machine)
/plugged/

# Tout ce qui est propre à la machine : historique, annulation, vues,
# sessions, thème, dictionnaire, réglages locaux, caches, journaux, sauvegardes
/local/

# Ancienne organisation (Vundle) — conservée ignorée pour les vieux clones
/bundle/
/vim-powerline-patched-fonts/

# Cache python (engendré dès qu'un test importe bin/vrc-interface ; un .pyc
# contient le chemin ABSOLU de son source, donc un chemin de home nommé)
__pycache__/
*.pyc

# Divers
/install.log
.netrwhist
*.swp
*.swo
.DS_Store
tags
