#!/usr/bin/env python3
"""bin/vrc-interface — les onglets de « vrc ui », posés sur le socle commun de dotlib.

L'affichage lui-même n'est plus ici : il vit dans ~/.dotlib/lib/onglets.py, partagé
avec la configuration bash pour que les deux interfaces soient identiques et corrigées
au même endroit. Ce fichier ne garde que ce qui est propre à vim : où trouver les
données, comment les produire, et dans quel ordre les montrer.

Le socle absent, trop ancien, ou d'une API que nous ne savons pas employer : on rend 4
avec une ligne sur la sortie d'erreur, et bin/vrc affiche le même contenu à la suite.
L'utilisateur n'est jamais les mains vides.

Ce fichier a porté sa propre interface curses jusqu'à ce que le socle ait été éprouvé
sur les machines du parc — jusqu'au 2026-09-29, et sur la plus contrainte d'entre elles
(python 3.8, aucune couleur, aucune locale transmise) pour la dernière vérification.
L'historique la garde si elle manque un jour.
"""

import sys

# Aucun cache d'octets, et c'est posé AVANT tout import : importer le socle commun ferait
# écrire un __pycache__ chez dotlib — un reste dans SON dépôt, et une écriture hors de
# ~/.vim. Vu en vrai ici même (commit ec0d242), donc verrouillé d'avance.
sys.dont_write_bytecode = True

import os

REPO = os.environ.get("VRC_REPO") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def module_dotlib():
    """Le socle commun d'interface à onglets de dotlib, s'il est utilisable.

    On ne teste JAMAIS la présence du dossier ~/.dotlib : dotlib peut être posé et
    complet sans porter ce module, qui est arrivé dans une version plus récente. On
    teste donc le fichier et l'API, et rien d'autre. Inutilisable pour quelque raison
    que ce soit → None, et vrc affiche son contenu à la suite, sans onglets.
    """
    dossier = os.path.join(os.environ.get("DOTLIB_DIR") or os.path.expanduser("~/.dotlib"), "lib")
    if not os.path.isfile(os.path.join(dossier, "onglets.py")):
        return None
    try:
        if dossier not in sys.path:
            sys.path.insert(0, dossier)
        import onglets
        acceptees = getattr(onglets, "API_COMPATIBLES", None) or (getattr(onglets, "API", 0),)
        if 1 not in tuple(acceptees):
            return None
        for necessaire in ("Onglet", "sortie", "lancer"):
            if not hasattr(onglets, necessaire):
                return None
    except Exception:
        return None
    return onglets

def raccourcis_tsv(sortie):
    """Les raccourcis de vim, et ceux du shell si sa propre aide est là."""
    lignes = []
    for l in sortie(["sh", os.path.join(REPO, "bin", "keys"), "--tsv"], cwd=REPO):
        champs = l.split("\t")
        if len(champs) >= 5:
            lignes.append(champs[:5])
    for outil in ("bindhelp", os.path.expanduser("~/.bash/bin/bindhelp")):
        essai = sortie([outil, "--tsv"], cwd=REPO)
        if essai and "\t" in "".join(essai):
            for l in essai:
                champs = l.split("\t")
                if len(champs) >= 5:
                    lignes.append(champs[:5])
            break
    return lignes

def construire(mod):
    """Les six onglets, bâtis avec le module qui les affichera. Les producteurs ne
    connaissent du socle que Onglet() et sortie() : rien de plus ne doit leur servir."""
    K = os.path.join(REPO, "bin", "keys")
    V = os.path.join(REPO, "bin", "vrc")

    def raccourcis():
        entrees = raccourcis_tsv(mod.sortie)
        reference = mod.sortie(["sh", K, "--ordre"], cwd=REPO)
        presents = [e[1] for e in entrees]
        themes = [t for t in reference if t in presents]
        for theme in presents:
            if theme not in themes:
                themes.append(theme)
        return {"entrees": entrees, "themes": themes}

    def texte(*commande):
        return lambda: mod.sortie(list(commande), cwd=REPO, delai=120)

    return [
        mod.Onglet("Raccourcis", raccourcis, genre="raccourcis"),
        mod.Onglet("État", texte("sh", V, "etat")),
        mod.Onglet("Greffons", texte("sh", V, "greffons")),
        mod.Onglet("Thèmes", texte("sh", V, "themes")),
        mod.Onglet("Journaux", texte("sh", V, "journal", "60")),
        mod.Onglet("Commandes", texte("sh", K, "--commandes")),
    ]

def main():
    mod = module_dotlib()
    if mod is None:
        print("vrc : socle d'interface indisponible (dotlib absent, ou sans le module "
              "des onglets)", file=sys.stderr)
        return 4
    return mod.lancer(construire(mod), "vrc")


if __name__ == "__main__":
    sys.exit(main())
