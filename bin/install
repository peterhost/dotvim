#!/bin/sh
# bin/install — installeur guidé de la configuration vim
#
#   sh bin/install              mode interactif (menus, valeurs par défaut sur Entrée)
#   sh bin/install --yes        sans question (ssh, scripts) : installe la branche courante
#   sh bin/install --try        essai côte à côte, sans rien activer
#   sh bin/install --branch B   choisir la branche (installation ou essai)
#   sh bin/install --no-plugins ne pas installer les plugins
#   sh bin/install --uninstall  retirer la config et restaurer la dernière sauvegarde
#   sh bin/install --check      diagnostic seul (système, vim, GitHub, paquets, restes) ; code 3 si dégradé
#   sh bin/install --clean      nettoie les restes (rien d'autre)
#   sh bin/install --check --json   état de la machine en JSON (pour un appelant tiers)
#
# Écrit en sh POSIX : macOS, Debian/Mint (dash), Synology (ash busybox),
# Cygwin, MSYS2/Git Bash, WSL. Rien n'est installé hors de $HOME, pas de sudo.

set -u
# Outils installés hors du PATH par défaut (Synology/Entware : /opt/bin, ajouté
# seulement par le .bashrc interactif ; paquets DSM : /usr/local/bin).
for d in ${MY_EXTRA_PATHS:-/opt/bin /opt/sbin /usr/local/bin}; do
  case ":$PATH:" in *":$d:"*) ;; *) [ -d "$d" ] && PATH="$PATH:$d" ;; esac
done
export PATH
REPO=$(cd "$(dirname "$0")/.." && pwd)
LOG="$REPO/local/install.log"
mkdir -p "$REPO/local" 2>/dev/null || true
STAMP=$(date +%Y%m%d-%H%M%S)
MARK="Généré par bin/install"

YES=0; MODE=""; BRANCH=""; PLUGINS=""; JSON=0
while [ $# -gt 0 ]; do
  case $1 in
    -y|--yes) YES=1 ;;
    --try) MODE=try ;;
    --uninstall) MODE=uninstall ;;
    --install) MODE=install ;;
    --check) MODE=check ;;
    --clean) MODE=clean ;;
    --json) JSON=1 ;;
    --branch) shift; BRANCH=${1:-} ;;
    --branch=*) BRANCH=${1#--branch=} ;;
    --no-plugins) PLUGINS=no ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Option inconnue : $1 (voir --help)" >&2; exit 2 ;;
  esac
  shift
done
# Sans terminal (ssh -T, cron, pipe) : aucune question.
[ -t 0 ] || YES=1

# --- Affichage -----------------------------------------------------------------------
if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  C_B=$(tput bold); C_G=$(tput setaf 2); C_R=$(tput setaf 1); C_Y=$(tput setaf 3)
  C_C=$(tput setaf 6); C_D=$(tput dim 2>/dev/null || true); C_N=$(tput sgr0)
else
  C_B=; C_G=; C_R=; C_Y=; C_C=; C_D=; C_N=
fi
title() { printf '\n%s%s== %s ==%s\n' "$C_B" "$C_C" "$1" "$C_N"; }
ok()    { printf '  %s✓%s %s\n' "$C_G" "$C_N" "$1"; }
warn()  { printf '  %s!%s %s\n' "$C_Y" "$C_N" "$1"; }
err()   { printf '  %s✗%s %s\n' "$C_R" "$C_N" "$1"; }
info()  { printf '  %s\n' "$1"; }
log()   { printf '%s %s\n' "$(date +%H:%M:%S)" "$1" >> "$LOG" 2>/dev/null || true; }
die()   { err "$1"; log "ERREUR $1"; exit 1; }

# ask <question> <défaut o|n> : 0 si oui
ask() {
  if [ "$YES" = 1 ]; then [ "$2" = o ]; return; fi
  if [ "$2" = o ]; then hint="[O/n]"; else hint="[o/N]"; fi
  printf '%s %s ' "$1" "$hint"
  read -r answer || answer=""
  [ -z "$answer" ] && answer=$2
  case $answer in [oOyY]*) return 0 ;; *) return 1 ;; esac
}

# choose <défaut> <option1> <option2> … : écrit le numéro choisi dans CHOICE
choose() {
  default=$1; shift
  i=1
  for opt in "$@"; do
    if [ "$i" = "$default" ]; then mark="$C_B>$C_N"; else mark=" "; fi
    printf '  %s %s%d)%s %s\n' "$mark" "$C_C" "$i" "$C_N" "$opt"
    i=$((i + 1))
  done
  CHOICE=$default
  [ "$YES" = 1 ] && return
  printf '  Choix [%s] : ' "$default"
  read -r answer || answer=""
  case $answer in
    ''|*[!0-9]*) ;;
    *) [ "$answer" -ge 1 ] && [ "$answer" -lt "$i" ] && CHOICE=$answer ;;
  esac
}

# --- Diagnostic ---------------------------------------------------------------------------
detect_os() {
  case $(uname -s 2>/dev/null) in
    Darwin) OS=macos; OS_LABEL="macOS $(sw_vers -productVersion 2>/dev/null)" ;;
    CYGWIN*) OS=cygwin; OS_LABEL="Cygwin" ;;
    MINGW*|MSYS*) OS=msys; OS_LABEL="MSYS2 / Git Bash" ;;
    Linux)
      if [ -f /etc/synoinfo.conf ]; then OS=synology; OS_LABEL="Synology DSM"
      elif grep -qi microsoft /proc/version 2>/dev/null; then OS=wsl; OS_LABEL="WSL"
      else
        OS=linux; OS_LABEL=Linux
        if [ -r /etc/os-release ]; then
          OS_LABEL=$(. /etc/os-release; printf '%s' "${PRETTY_NAME:-Linux}")
        fi
      fi ;;
    *) OS=unix; OS_LABEL=$(uname -s 2>/dev/null) ;;
  esac
}

detect_vim() {
  VIM_BIN=$(command -v vim 2>/dev/null || true)
  VIM_VER=0; VIM_EVAL=0; VIM_JOB=0; VIM_SIZE=""
  [ -n "$VIM_BIN" ] || return
  out=$("$VIM_BIN" --version 2>/dev/null)
  VIM_VER=$(printf '%s\n' "$out" | awk '/^VIM - Vi IMproved/ { split($5, v, "."); print v[1] * 100 + v[2]; exit }')
  VIM_VER=${VIM_VER:-0}
  case $out in *+eval*) VIM_EVAL=1 ;; esac
  case $out in *+job*) VIM_JOB=1 ;; esac
  VIM_SIZE=$(printf '%s\n' "$out" | grep -oE '(Huge|Big|Normal|Small|Tiny) version' | head -1 | cut -d' ' -f1)
}

tier() {
  if [ "$VIM_EVAL" != 1 ]; then echo minimal
  elif [ "$VIM_VER" -ge 800 ] && [ "$VIM_JOB" = 1 ]; then echo full
  elif [ "$VIM_VER" -ge 703 ]; then echo compat
  else echo minimal; fi
}

has() { command -v "$1" >/dev/null 2>&1; }

# Commande d'installation suggérée pour un outil, selon le système.
suggest() {
  case $OS in
    macos) pm="brew install" ;;
    linux|wsl) pm="sudo apt install" ;;
    synology) pm="opkg install  (Entware)" ;;
    cygwin) pm="setup-x86_64.exe -q -P" ;;
    msys) pm="pacman -S" ;;
    *) pm="(gestionnaire de paquets) " ;;
  esac
  case $1 in
    ruff) echo "pipx install ruff   (ou $pm ruff)" ;;
    pyright) echo "npm install -g pyright" ;;
    eslint|prettier) echo "npm install -g $1" ;;
    typescript-language-server) echo "npm install -g typescript typescript-language-server" ;;
    ctags) [ "$OS" = macos ] && echo "brew install universal-ctags" || echo "$pm universal-ctags" ;;
    rg) [ "$OS" = macos ] && echo "brew install ripgrep" || echo "$pm ripgrep" ;;
    xmllint) [ "$OS" = macos ] && echo "(fourni par macOS)" || echo "$pm libxml2-utils" ;;
    *) echo "$pm $1" ;;
  esac
}

# --- Accès à GitHub ---------------------------------------------------------------------
# Selon les machines, https ou ssh peut manquer : git des Synology sans
# git-remote-https ; compte sans clé SSH déclarée sur GitHub.
GH_TEST_REPO=${MY_GH_TEST_REPO:-junegunn/vim-plug}
REWRITE_FROM="https://github.com/ https://git::@github.com/"
to() { if has timeout; then timeout "$@"; else shift; "$@"; fi; }

net_test() {
  NET_HTTPS=0; NET_SSH=0
  has git || return 0
  GIT_TERMINAL_PROMPT=0 to 20 git ls-remote "https://github.com/$GH_TEST_REPO.git" HEAD >/dev/null 2>&1 && NET_HTTPS=1
  GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10" \
    to 20 git ls-remote "git@github.com:$GH_TEST_REPO.git" HEAD >/dev/null 2>&1 && NET_SSH=1
  return 0
}

GIT_USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/git/config"

origin_url() { git -C "$REPO" remote get-url origin 2>/dev/null || true; }

# Entware (Synology…) : git y est découpé en paquets ; sans « git-http »,
# git-remote-https manque et https est impossible.
opkg_bin() { command -v opkg 2>/dev/null || { [ -x /opt/bin/opkg ] && echo /opt/bin/opkg; } || true; }
https_helper_missing() {
  ep=$(git --exec-path 2>/dev/null) && [ -n "$ep" ] && [ ! -e "$ep/git-remote-https" ]
}

# Repli quand https ne peut pas être réparé : toute URL https GitHub passe par
# ssh. Règle rangée dans ~/.config/git/config (lu par git en plus de
# ~/.gitconfig), pour la garder à un seul endroit ; elle vaut pour tout git
# sur cette machine (plugins vim, ~/.tmux, ~/.bash…).
fix_rewrite() {
  mkdir -p "$(dirname "$GIT_USER_CONFIG")"
  for from in $REWRITE_FROM; do
    git config --get-all url.git@github.com:.insteadOf 2>/dev/null | grep -qxF "$from" \
      || git config --file "$GIT_USER_CONFIG" --add url.git@github.com:.insteadOf "$from"
  done
  ok "$(vim_path "$GIT_USER_CONFIG") : les URL https://github.com/ passent par ssh"
  log "réécriture https->ssh ajoutée à $GIT_USER_CONFIG"
}

fix_remote_https() {
  new=$(origin_url | sed -e 's#^git@github\.com:#https://github.com/#' -e 's#^ssh://git@github\.com/#https://github.com/#')
  git -C "$REPO" remote set-url origin "$new" && ok "Dépôt : origin -> $new" && log "origin -> $new"
}

# Propose les correctifs adaptés au résultat de net_test.
fix_network() {
  has git || return 0
  if [ "$NET_HTTPS" = 0 ] && [ "$NET_SSH" = 1 ]; then
    if [ -n "$(opkg_bin)" ] && https_helper_missing; then
      warn "https indisponible : il manque le paquet git-http. Solution durable :"
      info "    sudo $(opkg_bin) install git-http    (puis relancer l'installeur)"
      def=n
    else
      def=o
    fi
    if ask "  En attendant, faire passer les URL GitHub par ssh (règle dans ~/.config/git/config, vaut pour tout git) ?" "$def"; then
      fix_rewrite
    else
      warn "Sans https ni cette règle, les plugins ne pourront pas s'installer"
    fi
  fi
  case $(origin_url) in
    git@github.com:*|ssh://git@github.com/*)
      if [ "$NET_SSH" = 0 ] && [ "$NET_HTTPS" = 1 ]; then
        if ask "  Pas de clé SSH GitHub ici : passer l'adresse du dépôt en https (pour git pull) ?" o; then
          fix_remote_https
        fi
      fi ;;
  esac
}

# --- Paquets Entware (opkg) ---------------------------------------------------------------
# Sur une machine Entware (Synology…), opkg demande sudo : l'installeur ne
# l'appelle jamais pour installer, il vérifie et donne la commande exacte.
# Disponibilité dans le dépôt : `opkg list` si possible, sinon ~/opkglist.txt
# (sortie de `opkg list` déposée par l'utilisateur).
OPKG_TOOLS="fzf:fzf rg:ripgrep ctags:ctags xmllint:libxml2-utils make:make"

opkg_available() { # opkg_available <paquet> : 0 dispo, 1 absent, 2 inconnu
  [ -n "$OPKG_LIST" ] || return 2
  printf '%s\n' "$OPKG_LIST" | grep -q "^$1 - "
}

entware_check() {
  ENTWARE=0
  OPKG=$(opkg_bin); [ -n "$OPKG" ] || return 0
  ENTWARE=1
  OPKG_LIST=$("$OPKG" list 2>/dev/null || true)
  [ -n "$OPKG_LIST" ] || { [ -r "$HOME/opkglist.txt" ] && OPKG_LIST=$(cat "$HOME/opkglist.txt"); }
  need=""; want=""; missing=""; upgrade=""
  if has git && [ "$NET_HTTPS" = 0 ] && https_helper_missing; then need="git-http"; fi
  for pair in $OPKG_TOOLS; do
    cmd=${pair%%:*}; pkg=${pair#*:}
    if has "$cmd"; then
      [ "$cmd" = ctags ] && ! ctags --version 2>/dev/null | grep -qi universal || continue
    fi
    opkg_available "$pkg"; case $? in 1) missing="$missing $pkg" ;; *) want="$want $pkg" ;; esac
  done
  # bibliothèque trop ancienne pour les outils récents (vu sur DSM 7.2)
  for cmd in ctags rg; do
    has "$cmd" && "$cmd" --version 2>&1 >/dev/null | grep -q 'libpcre2.*no version information' && upgrade="libpcre2"
  done
  OPKG_NEEDED="$need$want"
  if [ "$JSON" = 1 ]; then return 0; fi
  title "Paquets Entware (opkg)"
  if [ -z "$need$want$upgrade" ]; then ok "Rien à installer"; fi
  [ -n "$need" ] && warn "Indispensable : $need (sans lui, pas de https : plugins impossibles)"
  [ -n "$want" ] && info "Utiles :$want"
  [ -n "$missing" ] && info "Absents du dépôt de cette machine (la config s'en passe) :$missing"
  [ -n "$upgrade" ] && warn "$upgrade trop ancien : ctags / rg affichent un avertissement à chaque appel"
  if [ -n "$need$want" ]; then
    info "À lancer (sudo) :"
    info "    sudo $OPKG install $(echo $need $want)"
  fi
  [ -n "$upgrade" ] && info "    sudo $OPKG upgrade $upgrade"
  [ -n "$OPKG_LIST" ] || info "(dépôt non consulté : opkg list demande sudo ; déposez sa sortie dans ~/opkglist.txt)"
  return 0
}

# dotlib : la bibliothèque commune au shell (dépôt public, installée en
# ~/.dotlib). Seule sa LECTURE nous intéresse : accorder le clair/sombre de vim
# à celui du shell. Absente, vim garde son thème — ce n'est pas une dépendance.
# Ordre de lecture, identique à celui de vim (autoload/my/colors.vim) :
# variables exportées par le shell, puis local/theme.conf, puis rien.
dotlib_state() {
  DOTLIB_PLACE=${DOTLIB_DIR:-$HOME/.dotlib}
  DOTLIB_OK=0; DOTLIB_SRC=aucun; DOTLIB_TH=; DOTLIB_PAL=
  if [ -n "${DOTLIB_THEME_EFF:-}" ] || [ -n "${DOTLIB_PALETTE_EFF:-}" ]; then
    DOTLIB_OK=1; DOTLIB_SRC=environnement
    DOTLIB_TH=${DOTLIB_THEME_EFF:-}; DOTLIB_PAL=${DOTLIB_PALETTE_EFF:-}
  elif [ -r "$DOTLIB_PLACE/local/theme.conf" ]; then
    DOTLIB_OK=1; DOTLIB_SRC=fichier
    DOTLIB_TH=$(sed -n 's/^[ 	]*DOTLIB_THEME=//p' "$DOTLIB_PLACE/local/theme.conf" | tail -1)
    DOTLIB_PAL=$(sed -n 's/^[ 	]*DOTLIB_PALETTE=//p' "$DOTLIB_PLACE/local/theme.conf" | tail -1)
  elif [ -d "$DOTLIB_PLACE" ]; then
    DOTLIB_OK=1; DOTLIB_SRC=installé
  fi
}

diagnose() {
  title "Diagnostic"
  detect_os; detect_vim
  info "Système      : $OS_LABEL"
  info "Config       : $(vim_path "$REPO")"
  if [ -n "$VIM_BIN" ]; then
    info "vim          : $VIM_BIN ($((VIM_VER / 100)).$((VIM_VER % 100)), ${VIM_SIZE:-?})"
  else
    warn "vim introuvable dans le PATH"
  fi
  TIER=$(tier)
  case $TIER in
    full) ok "Niveau prévu : complet (tous les plugins)" ;;
    compat) warn "Niveau prévu : compatibilité (vim < 8 : plugins sans tâches de fond)" ;;
    minimal) warn "Niveau prévu : minimal (options et raccourcis, pas de plugins)" ;;
  esac
  if has git; then
    ok "git présent ($(git --version 2>/dev/null | sed 's/git version //'))"
    net_test
    if [ "$NET_HTTPS" = 1 ] && [ "$NET_SSH" = 1 ]; then ok "GitHub joignable en https et en ssh"
    elif [ "$NET_HTTPS" = 1 ]; then ok "GitHub joignable en https (ssh : pas de clé déclarée)"
    elif [ "$NET_SSH" = 1 ]; then warn "GitHub : https indisponible, ssh OK (une règle sera proposée)"
    else warn "GitHub injoignable (https et ssh) : plugins non installables, vim marchera sans"; fi
  else
    warn "git absent : plugins impossibles à installer (mode minimal)"; NET_HTTPS=0; NET_SSH=0
  fi
  if has curl || has wget; then ok "curl/wget présent"; else warn "ni curl ni wget : binaires fzf / markdown-preview non téléchargeables"; fi
  info "Terminal     : TERM=${TERM:-?}, $(tput colors 2>/dev/null || echo '?') couleurs${COLORTERM:+, COLORTERM=$COLORTERM}"
  BRANCH_CUR=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
  info "Branche      : $BRANCH_CUR"

  MISSING=""
  printf '  Outils facultatifs :'
  for t in fzf rg ctags node jq xmllint ruff pyright eslint prettier typescript-language-server; do
    if has "$t"; then printf ' %s%s%s' "$C_G" "$t" "$C_N"
    else printf ' %s%s%s' "$C_D" "$t" "$C_N"; MISSING="$MISSING $t"; fi
  done
  printf '\n'
  if has ctags && ! ctags --version 2>/dev/null | grep -qi universal; then
    warn "ctags n'est pas universal-ctags : Tagbar ne fonctionnera pas ($(suggest ctags))"
  fi
  dotlib_state
  if [ "$DOTLIB_OK" = 1 ]; then
    info "dotlib       : $(vim_path "$DOTLIB_PLACE") ($DOTLIB_SRC${DOTLIB_TH:+, thème $DOTLIB_TH}${DOTLIB_PAL:+, palette $DOTLIB_PAL}) — vim n'en suit que le clair/sombre"
  else
    info "dotlib       : absent — vim garde son propre thème (aucune dépendance)"
  fi
  entware_check
}

# --- Actions ---------------------------------------------------------------------------------
# Chemin lisible dans un vimrc : ~/… si possible, espaces échappés.
HOME_REAL=$(cd "$HOME" 2>/dev/null && pwd || printf '%s' "$HOME")
vim_path() {
  case $1 in "$HOME_REAL"/*) p="~/${1#"$HOME_REAL"/}" ;; *) p=$1 ;; esac
  printf '%s' "$p" | sed 's/ /\\ /g'
}

# Sauvegardes rangées dans local/backup/ (rien ne reste dans $HOME).
BACKUP_DIR="$REPO/local/backup"
backup() { # backup <fichier> : le met de côté (sauf s'il vient de nous)
  if [ -e "$1" ] || [ -L "$1" ]; then
    if [ ! -L "$1" ] && grep -q "$MARK" "$1" 2>/dev/null; then
      rm -f "$1"; return
    fi
    mkdir -p "$BACKUP_DIR"
    dest="$BACKUP_DIR/$(basename "$1").$STAMP"
    mv "$1" "$dest" && ok "Sauvegarde : $(vim_path "$1") -> $(vim_path "$dest")" && log "sauvegarde $1 -> $dest"
  fi
}

write_stub() { # write_stub <~/.vimrc> <vimrc du dépôt>
  backup "$1"
  {
    printf '" %s (%s) — ne pas modifier :\n' "$MARK" "$STAMP"
    printf '" les réglages propres à cette machine vont dans %s\n' "$(vim_path "$REPO/local/vimrc.local")"
    printf 'source %s\n' "$(vim_path "$2")"
  } > "$1"
  ok "$(vim_path "$1") -> $(vim_path "$2")"; log "stub $1 -> $2"
}

# Depuis vim 7.4, ~/.vim/vimrc et ~/.vim/gvimrc sont lus directement : aucun
# fichier n'est alors nécessaire dans $HOME. Un fichier d'une ligne reste
# utile pour un vim plus ancien, ou une config clonée ailleurs que ~/.vim.
needs_stub() {
  std=$(cd "$HOME/.vim" 2>/dev/null && pwd || true)
  [ "${VIM_VER:-0}" -lt 704 ] || [ "$REPO" != "$std" ]
}

link_config() { # link_config <~/.vimrc> <fichier du dépôt>
  if needs_stub; then
    write_stub "$1" "$2"
  else
    backup "$1"
    ok "$(vim_path "$1") inutile : vim lit directement $(vim_path "$2")"
  fi
}

# Réglages propres à la machine : local/vimrc.local et local/gvimrc.local.
# Les anciens ~/.vimrc.local / ~/.gvimrc.local (souvent des liens vers le
# dépôt) sont déplacés s'ils ont du contenu, retirés s'ils sont vides.
migrate_local() { # migrate_local <~/.vimrc.local> <nom dans local/>
  [ -e "$1" ] || [ -L "$1" ] || return 0
  dest="$REPO/local/$2"
  if [ -s "$1" ] && grep -q '[^[:space:]]' "$1" 2>/dev/null; then
    mkdir -p "$REPO/local"
    if [ -e "$dest" ]; then
      backup "$1"
      warn "$(vim_path "$dest") existe déjà : $(vim_path "$1") mis de côté, à fusionner à la main"
    else
      cat "$1" > "$dest" && rm -f "$1" \
        && ok "$(vim_path "$1") déplacé dans $(vim_path "$dest")"
    fi
  else
    rm -f "$1" && ok "$(vim_path "$1") vide, retiré"
  fi
  log "migration $1 -> $dest"
}

# Dictionnaire personnel : l'ancien, suivi par git (spell/*.add), est copié
# dans local/spell/ avant tout changement de branche ou suppression des
# modifications locales, pour ne perdre aucun mot ajouté.
migrate_spell() {
  for f in "$REPO"/spell/*.add; do
    [ -f "$f" ] || continue
    dest="$REPO/local/spell/$(basename "$f")"
    [ -e "$dest" ] && continue
    mkdir -p "$REPO/local/spell" && cp "$f" "$dest" \
      && ok "Dictionnaire personnel repris : $(vim_path "$dest") ($(wc -l < "$dest" | tr -d ' ') mots)" \
      && log "dictionnaire $f -> $dest"
  done
}

# Échecs signalés par vim-plug dans son rapport : « x <nom>: » suivi du détail.
# Ils sont annoncés dès que le rapport existe, nom et cause, sur la sortie
# d'erreur — sans quoi une pose se terminait sur un message d'apparence
# réussie alors qu'un greffon manquait.
report_failures() { # report_failures <rapport>
  [ -f "$1" ] || return 0
  awk '
    function flush() {
      if (name != "") {
        why = (best != "" ? best : first)
        if (why == "") why = "cause inconnue (voir le journal)"
        printf "  greffon %s : échec — %s\n", name, why
      }
      name = ""; first = ""; best = ""
    }
    /^x / { flush(); name = $0; sub(/^x /, "", name); sub(/:[ \t]*$/, "", name); next }
    /^[-x] / { flush(); next }
    name != "" && /^[ \t]+[^ \t]/ {
      line = $0; gsub(/^[ \t]+/, "", line); gsub(/[ \t]+$/, " ", line)
      if (first == "") first = line
      # on retient la ligne qui dit vraiment pourquoi
      if (best == "" && line ~ /fatal:|error:|not found|Not Found|Permission denied|Could not resolve|timed out|denied|remote:/) best = line
    }
    END { flush() }
  ' "$1" >&2
}

install_plugins() { # install_plugins <dossier de config>
  if ! has git; then warn "git absent : plugins non installés"; return; fi
  if [ -z "$VIM_BIN" ] || [ "$VIM_EVAL" != 1 ]; then warn "vim sans +eval : plugins inutiles"; return; fi
  plugins_state   # renseigne PLUG_TOTAL (déclarés) et PLUG_INSTALLED
  total=${PLUG_TOTAL:-0}
  info "Installation des plugins${total:+ (}${total:+$total}${total:+ déclarés)}…"
  log "PlugInstall dans $1"
  report="$1/local/install-report.txt"
  mkdir -p "$1/local"

  # Progression : chaque greffon qui apparaît dans plugged/ est annoncé sur la
  # sortie d'erreur, pour qu'un appelant (ou l'utilisateur) voie défiler la
  # phase longue au lieu d'une seule ligne d'attente.
  plugins_hooks
  [ -n "$PLUG_HOOKS" ] && info "  à construire après clonage (npm, téléchargements) : $PLUG_HOOKS"
  guard="$1/local/.progress.$$"; seen="$1/local/.seen.$$"
  : > "$guard"; : > "$seen"
  (
    announced=0; waited=0
    while [ -f "$guard" ]; do
      for d in "$1"/plugged/*/; do
        [ -d "$d" ] || continue
        n=$(basename "$d")
        grep -qxF "$n" "$seen" 2>/dev/null && continue
        printf '%s\n' "$n" >> "$seen"
        printf '  greffon %s/%s : %s\n' "$(grep -c . "$seen" | tr -d ' ')" "${total:-?}" "$n" >&2
      done
      # tous les clonages faits : la suite est la construction, longue et muette
      if [ "$announced" = 0 ] && [ -n "$total" ] && [ "$total" != 0 ] \
         && [ "$(grep -c . "$seen" | tr -d ' ')" -ge "$total" ]; then
        announced=1; waited=0
        if [ -n "$PLUG_HOOKS" ]; then
          printf '  clonages terminés — construction de : %s\n' "$PLUG_HOOKS" >&2
        else
          printf '  clonages terminés — vérifications finales…\n' >&2
        fi
      fi
      # battement pendant la construction, pour ne pas paraître figé
      if [ "$announced" = 1 ]; then
        waited=$((waited + 1))
        if [ $((waited % 15)) = 0 ]; then
          printf '  construction en cours… (%s s)\n' "$waited" >&2
        fi
      fi
      sleep 1
    done
  ) &
  progress=$!

  MY_VIM_NO_AUTOUPDATE=1 "$VIM_BIN" -N -u "$1/vimrc" -i NONE -es \
    -c 'PlugInstall --sync' -c "silent! write! $report" -c 'qa!' </dev/null >>"$LOG" 2>&1
  rc=$?
  rm -f "$guard"; wait "$progress" 2>/dev/null; rm -f "$seen"
  cat "$report" >> "$LOG" 2>/dev/null
  report_failures "$report"

  info "  vérification des greffons…"
  # Vérification : l'installation n'est pas terminée parce que vim a rendu la
  # main, mais parce que les greffons attendus sont là. Un échec passager
  # (réseau) est retenté une fois, puis nommé.
  plugins_state
  if [ "${PLUG_MISSING:-0}" -gt 0 ]; then
    warn "$PLUG_MISSING greffon(s) manquant(s) après l'installation : nouvel essai"
    log "nouvel essai pour : $PLUG_MISSING_NAMES"
    MY_VIM_NO_AUTOUPDATE=1 "$VIM_BIN" -N -u "$1/vimrc" -i NONE -es \
      -c 'PlugInstall --sync' -c "silent! write! $report" -c 'qa!' </dev/null >>"$LOG" 2>&1
    cat "$report" >> "$LOG" 2>/dev/null
    report_failures "$report"
    plugins_state
  fi
  rm -f "$report"

  if [ "${PLUG_MISSING:-0}" -gt 0 ]; then
    err "Greffon(s) NON installé(s) : $PLUG_MISSING_NAMES"
    info "  vim les réinstallera seul en arrière-plan et le rappellera à chaque démarrage."
  else
    mkdir -p "$1/local" && touch "$1/local/last-update"
    ok "Plugins installés (${PLUG_INSTALLED:-?}/${PLUG_TOTAL:-?})"
  fi
  if [ "${PLUG_SKIPPED:-0}" -gt 0 ]; then
    info "  $PLUG_SKIPPED greffon(s) écarté(s) sur cette machine (vim ou outil manquant) : $PLUG_SKIPPED_NAMES"
  fi
  [ "$rc" = 0 ] || warn "PlugInstall a signalé un problème (voir $(vim_path "$LOG"))"
}

check_config() { # check_config <dossier> : démarrage à blanc, erreurs éventuelles
  [ -n "$VIM_BIN" ] || return
  out="$1/local/check.txt"; mkdir -p "$1/local"; rm -f "$out"
  MY_VIM_NO_AUTOUPDATE=1 "$VIM_BIN" -N -u "$1/vimrc" -i NONE -es -c "redir! > $out" -c 'silent messages' \
    -c 'redir END' -c 'qa!' </dev/null >/dev/null 2>&1
  if [ -f "$out" ] && grep -Eq '^E[0-9]+:|Error detected' "$out"; then
    warn "vim signale des erreurs au démarrage :"; grep -E '^E[0-9]+:|line' "$out" | head -5 | sed 's/^/      /'
  else
    ok "Démarrage de vim vérifié : aucune erreur"
  fi
  rm -f "$out"
}

# Restes de l'ancienne configuration (Vundle, FuzzyFinder, ancien mode
# essai) : inutiles une fois la nouvelle installée ; listés puis supprimés.
# --- Zéro reste --------------------------------------------------------------------------
# Un déploiement ne doit rien laisser derrière lui. On ne touche qu'à une liste
# connue : restes de l'ancienne configuration, fichiers transitoires, vieilles
# sauvegardes. Les données de la machine (local/spell, viminfo, undo, sessions,
# views, *.local) ne sont JAMAIS supprimées.
LEGACY_FILES="colors/default-light.vim colors/dim.vim .netrwhist install.log"
BACKUP_KEEP=3

tracked() { git -C "$REPO" ls-files --error-unmatch "$1" >/dev/null 2>&1; }

# Liste les restes présents, un par ligne, sans rien modifier.
crumbs_list() {
  for f in $LEGACY_FILES; do
    [ -e "$REPO/$f" ] || continue
    tracked "$f" && continue
    echo "$REPO/$f"
  done
  # dictionnaire de l'ancienne config : supprimé seulement si les mots ont bien
  # été recopiés dans local/spell/ (sinon on préfère le garder)
  for f in "$REPO"/spell/*.add "$REPO"/spell/*.add.spl; do
    [ -f "$f" ] || continue
    rel=${f#"$REPO"/}
    tracked "$rel" && continue
    b=${f##*/}; words=${b%.spl}
    [ -f "$REPO/local/spell/$words" ] || continue
    echo "$f"
  done
  # transitoires
  for f in "$REPO/local/update-report.txt" "$REPO/local/check.txt"; do
    [ -f "$f" ] && echo "$f"
  done
  if [ -d "$REPO/local/update.lock" ] && [ -n "$(find "$REPO/local/update.lock" -mmin +60 2>/dev/null)" ]; then
    echo "$REPO/local/update.lock"
  fi
  # sauvegardes : on garde les $BACKUP_KEEP plus récentes de chaque fichier
  for n in .vimrc .gvimrc; do
    ls -1d "$BACKUP_DIR/$n".* 2>/dev/null | sort \
      | awk -v k="$BACKUP_KEEP" '{a[NR]=$0} END {for (i = 1; i <= NR - k; i++) print a[i]}'
  done
}

prune_crumbs() {
  list=$(crumbs_list)
  n=$(printf '%s' "$list" | grep -c . || true)
  if [ "${n:-0}" -gt 0 ]; then
    printf '%s\n' "$list" | while IFS= read -r f; do
      [ -n "$f" ] || continue
      rm -rf "$f" && log "reste supprimé : $f"
    done
    ok "Restes supprimés : $n"
  fi
  # journal borné, comme celui des mises à jour
  if [ -f "$LOG" ] && [ "$(wc -l < "$LOG" | tr -d ' ')" -gt 500 ]; then
    tail -n 500 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" && ok "Journal tronqué (500 dernières lignes)"
  fi
  [ "${n:-0}" -gt 0 ] || ok "Aucun reste : rien à nettoyer"
}

helptags_doc() { # balises de l’aide maison (:help raccourcis) ; doc/tags n’est pas versionné
  [ -f "$1/doc/raccourcis.txt" ] && [ -n "$VIM_BIN" ] || return 0
  if "$VIM_BIN" -es -u NONE -c "helptags $1/doc" -c 'qa!' </dev/null >/dev/null 2>&1; then
    ok "Aide des raccourcis indexée (:help raccourcis, :Keys)"
  else
    warn "Balises de l’aide non engendrées : :help raccourcis indisponible"
  fi
}

cleanup_legacy() {
  set --
  [ -d "$REPO/bundle" ] && set -- "$@" "$REPO/bundle"
  [ -d "$REPO/vim-powerline-patched-fonts" ] && set -- "$@" "$REPO/vim-powerline-patched-fonts"
  [ -d "$HOME/.vim-fuf-data" ] && set -- "$@" "$HOME/.vim-fuf-data"
  [ -f "$HOME/.viminfo.vimnew" ] && set -- "$@" "$HOME/.viminfo.vimnew"
  [ $# -eq 0 ] && return 0
  info "Restes de l'ancienne configuration :"
  for f in "$@"; do printf '      %-40s %s\n' "$(vim_path "$f")" "$(du -sh "$f" 2>/dev/null | cut -f1)"; done
  if ask "  Les supprimer ?" o; then
    for f in "$@"; do rm -rf "$f" && log "supprimé : $f"; done
    ok "Restes de l'ancienne configuration supprimés"
  fi
}

# Plugins absents (hors ligne, git absent…) : le dire, et rappeler que vim
# les installera tout seul et le signalera à chaque démarrage d'ici là.
plugins_notice() { # plugins_notice <dossier de config>
  [ "$TIER" = minimal ] && return 0
  [ -d "$1/plugged" ] && [ -n "$(ls "$1/plugged" 2>/dev/null)" ] && return 0
  warn "Aucun plugin installé pour l'instant."
  info "  vim les installera tout seul en arrière-plan au prochain démarrage où GitHub"
  info "  est joignable, et le rappellera à chaque démarrage tant qu'ils manquent."
}

branches() {
  # refs/heads/X et refs/remotes/<dépôt>/X -> X (sans les HEAD symboliques)
  git -C "$REPO" for-each-ref --format='%(refname)' refs/heads refs/remotes 2>/dev/null \
    | sed -e 's#^refs/heads/##' -e 's#^refs/remotes/[^/]*/##' | grep -v '^HEAD$' | sort -u
}

checkout() { # checkout <branche> : les modifications locales sont supprimées
  [ "$1" = "$BRANCH_CUR" ] && return 0
  changes=$(git -C "$REPO" status --porcelain 2>/dev/null)
  if [ -n "$changes" ]; then
    warn "Modifications locales dans $(vim_path "$REPO") (supprimées pour changer de branche) :"
    printf '%s\n' "$changes" | head -20 | sed 's/^/      /'
    [ "$(printf '%s\n' "$changes" | wc -l)" -gt 20 ] && info "      …"
    if ! ask "  Supprimer ces modifications ?" o; then
      err "Changement de branche annulé"; return 1
    fi
    # fichiers suivis remis à l'état du dépôt, fichiers non suivis retirés ;
    # les fichiers ignorés (bundle/, plugged/, local/…) ne sont pas touchés
    git -C "$REPO" reset -q --hard && git -C "$REPO" clean -qfd \
      && ok "Modifications locales supprimées" && log "modifications supprimées : $(printf '%s' "$changes" | tr '\n' ' ')"
  fi
  git -C "$REPO" checkout -q "$1" 2>>"$LOG" \
    || git -C "$REPO" checkout -q -b "$1" "origin/$1" 2>>"$LOG" \
    || { err "Branche introuvable : $1"; return 1; }
  ok "Branche $1 sélectionnée"; log "checkout $1"; BRANCH_CUR=$1
}

do_install() {
  title "Installation"
  : > "$LOG.tmp" && rm -f "$LOG.tmp"
  fix_network
  migrate_spell
  checkout "$BRANCH" || exit 1
  link_config "$HOME/.vimrc" "$REPO/vimrc"
  link_config "$HOME/.gvimrc" "$REPO/gvimrc"
  migrate_local "$HOME/.vimrc.local" vimrc.local
  migrate_local "$HOME/.gvimrc.local" gvimrc.local
  [ "$PLUGINS" = no ] || install_plugins "$REPO"
  helptags_doc "$REPO"
  cleanup_legacy
  prune_crumbs
  check_config "$REPO"
  plugins_notice "$REPO"
  title "Terminé"
  ok "vim utilise maintenant $(vim_path "$REPO") (branche $BRANCH_CUR)"
  info "Retour arrière : sh $(vim_path "$REPO")/bin/install --uninstall"
}

do_try() {
  title "Essai côte à côte"
  fix_network
  target=$REPO
  if [ "$BRANCH" != "$BRANCH_CUR" ]; then
    target="$HOME/.vimnew"
    [ "$YES" = 1 ] || { printf '  Dossier de l'"'"'essai [%s] : ' "$target"; read -r answer || answer=""; [ -n "$answer" ] && target=$answer; }
    if [ -e "$target" ]; then
      die "$target existe déjà : choisissez un autre dossier ou supprimez-le (git worktree remove $target)"
    fi
    git -C "$REPO" worktree add -q "$target" "$BRANCH" 2>>"$LOG" \
      || git -C "$REPO" worktree add -q -b "$BRANCH" "$target" "origin/$BRANCH" 2>>"$LOG" \
      || die "Impossible de créer $target pour la branche $BRANCH (voir $LOG)"
    ok "Branche $BRANCH disponible dans $(vim_path "$target")"
  fi
  [ "$PLUGINS" = no ] || install_plugins "$target"
  check_config "$target"
  plugins_notice "$target"
  title "Pour essayer"
  info "vim -u $(vim_path "$target/vimrc")"
  info "Alias pratique : alias vimnew='vim -u $(vim_path "$target/vimrc")'"
  info "Votre configuration actuelle n'a pas été modifiée."
}

do_uninstall() {
  title "Désinstallation"
  for f in "$HOME/.vimrc" "$HOME/.gvimrc"; do
    if grep -q "$MARK" "$f" 2>/dev/null; then
      rm -f "$f" && ok "$(vim_path "$f") retiré"
    fi
    # sauvegarde la plus récente : local/backup/ (ou ancien emplacement ~/.vimrc.bak-*)
    last=$(ls -1d "$BACKUP_DIR/$(basename "$f")".* 2>/dev/null | sort | tail -1)
    [ -n "$last" ] || last=$(ls -1d "$f".bak-* 2>/dev/null | sort | tail -1)
    if [ -n "$last" ] && [ ! -e "$f" ] && [ ! -L "$f" ]; then
      mv "$last" "$f" && ok "$(vim_path "$f") restauré depuis $(vim_path "$last")"
    fi
  done
  # Après restauration, la configuration peut rester active : soit parce que
  # vim lit ~/.vim/vimrc quand il n'y a pas de ~/.vimrc, soit parce que le
  # fichier restauré mène lui-même à cette configuration (ancien lien
  # symbolique ~/.vimrc -> .vim/vimrc, vu sur un hôte du parc).
  still=""
  if [ ! -e "$HOME/.vimrc" ] && [ ! -L "$HOME/.vimrc" ] \
     && [ "$REPO" = "$(cd "$HOME/.vim" 2>/dev/null && pwd || true)" ]; then
    still="aucun ~/.vimrc : vim lit directement $(vim_path "$REPO/vimrc")"
  elif [ -L "$HOME/.vimrc" ]; then
    # comparaison en chemins physiques (readlink -f les résout, pwd non)
    t=$(readlink -f "$HOME/.vimrc" 2>/dev/null || true)
    repo_phys=$(cd "$REPO" 2>/dev/null && pwd -P || printf '%s' "$REPO")
    case $t in "$repo_phys"/*) still="~/.vimrc (restauré) pointe vers $(vim_path "$t")" ;; esac
  elif [ -f "$HOME/.vimrc" ] && grep -qF "$REPO/vimrc" "$HOME/.vimrc" 2>/dev/null; then
    still="~/.vimrc (restauré) charge $(vim_path "$REPO/vimrc")"
  fi
  if [ -n "$still" ]; then
    warn "La configuration reste ACTIVE : $still"
    info "  Pour la désactiver vraiment : renommer ou supprimer $(vim_path "$REPO")."
  fi
  info "Les plugins et les réglages locaux ($(vim_path "$REPO/local")) sont conservés."
}

# --- État lisible par un programme (--check --json) -------------------------------------
# Destiné à un appelant tiers (interface de déploiement, supervision…). Cette
# configuration ne connaît aucune machine : elle décrit seulement celle où elle
# tourne. Codes de sortie : 0 conforme, 1 erreur, 2 usage, 3 dégradé.
# Liste de mots -> tableau JSON
json_list() {
  printf '['
  first=1
  for w in ${1:-}; do
    [ "$first" = 1 ] || printf ','
    json_str "$w"; first=0
  done
  printf ']'
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/ /g')"; }

# Nombre de plugins déclarés / manquants (demandé à vim, qui seul connaît la liste).
# Greffons déclarés avec une commande de construction (crochet « do » de
# vim-plug : npm, téléchargement de binaire…). C'est la phase la plus longue
# après les clonages, et elle était muette.
plugins_hooks() {
  PLUG_HOOKS=""
  [ -n "$VIM_BIN" ] && [ "$VIM_EVAL" = 1 ] || return 0
  tmp="$REPO/local/hooks.$$"
  MY_VIM_NO_AUTOUPDATE=1 "$VIM_BIN" -N -u "$REPO/vimrc" -i NONE -es \
    -c "redir! > $tmp" \
    -c "silent echo join(sort(filter(keys(get(g:, 'plugs', {})), 'has_key(g:plugs[v:val], \"do\")')), ' ')" \
    -c 'redir END' -c 'qa!' </dev/null >/dev/null 2>&1
  PLUG_HOOKS=$(tr -d '\r' < "$tmp" 2>/dev/null | sed -n '2p')
  rm -f "$tmp"
}

plugins_state() {
  PLUG_TOTAL=0; PLUG_MISSING=0; PLUG_MISSING_NAMES=""; PLUG_SKIPPED=0; PLUG_SKIPPED_NAMES=""
  PLUG_INSTALLED=$(ls "$REPO/plugged" 2>/dev/null | wc -l | tr -d ' ')
  [ -n "$VIM_BIN" ] && [ "$VIM_EVAL" = 1 ] || return 0
  # en mode -es, « echo » ne sort pas sur la sortie standard : on passe par redir
  tmp="$REPO/local/plugins-state.$$"
  MY_VIM_NO_AUTOUPDATE=1 "$VIM_BIN" -N -u "$REPO/vimrc" -i NONE -es \
    -c "redir! > $tmp" \
    -c 'silent echo len(keys(get(g:, "plugs", {}))) len(my#update#missing())' \
    -c 'silent echo join(my#update#missing(), " ")' \
    -c 'silent echo join(my#update#skipped(), " ")' \
    -c 'redir END' -c 'qa!' </dev/null >/dev/null 2>&1
  out=$(tr -d '\r' < "$tmp" 2>/dev/null | grep -E '^[0-9]+ [0-9]+$' | head -1)
  PLUG_MISSING_NAMES=$(tr -d '\r' < "$tmp" 2>/dev/null | sed -n '3p')
  PLUG_SKIPPED_NAMES=$(tr -d '\r' < "$tmp" 2>/dev/null | sed -n '4p')
  rm -f "$tmp"
  PLUG_SKIPPED=$(printf '%s' "$PLUG_SKIPPED_NAMES" | wc -w | tr -d ' ')
  [ -n "$out" ] || return 0
  PLUG_TOTAL=${out%% *}; PLUG_MISSING=${out##* }
}

print_json() {
  crumbs=$(crumbs_list | grep -c . || true)
  plugins_state
  upd=$(head -1 "$REPO/local/update-status" 2>/dev/null || echo unknown)
  commit=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo "")
  remote=$(origin_url)
  rc=0
  [ "${crumbs:-0}" -gt 0 ] && rc=3
  [ "${PLUG_MISSING:-0}" -gt 0 ] && rc=3
  [ "$TIER" != minimal ] && [ "${PLUG_INSTALLED:-0}" = 0 ] && rc=3
  has git || rc=3
  printf '{'
  printf '"host":%s,'    "$(json_str "$(hostname 2>/dev/null)")"
  printf '"user":%s,'    "$(json_str "$(id -un 2>/dev/null)")"
  printf '"os":%s,'      "$(json_str "$OS_LABEL")"
  printf '"os_kind":%s,' "$(json_str "$OS")"
  printf '"dir":%s,'     "$(json_str "$REPO")"
  printf '"vim":%s,'     "$(json_str "$([ -n "$VIM_BIN" ] && printf '%s.%s' "$((VIM_VER / 100))" "$((VIM_VER % 100))")")"
  printf '"vim_path":%s,' "$(json_str "$VIM_BIN")"
  printf '"vim_build":%s,' "$(json_str "$VIM_SIZE")"
  printf '"tier":%s,'    "$(json_str "$TIER")"
  printf '"git":%s,'     "$(json_str "$(git --version 2>/dev/null | sed 's/git version //')")"
  printf '"github_https":%s,' "$([ "${NET_HTTPS:-0}" = 1 ] && echo true || echo false)"
  printf '"github_ssh":%s,'   "$([ "${NET_SSH:-0}" = 1 ] && echo true || echo false)"
  printf '"remote":%s,'  "$(json_str "$remote")"
  printf '"branch":%s,'  "$(json_str "$BRANCH_CUR")"
  printf '"commit":%s,'  "$(json_str "$commit")"
  printf '"plugins_installed":%s,' "${PLUG_INSTALLED:-0}"
  printf '"plugins_declared":%s,'  "${PLUG_TOTAL:-0}"
  printf '"plugins_missing":%s,'   "${PLUG_MISSING:-0}"
  printf '"plugins_missing_names":%s,' "$(json_list "$PLUG_MISSING_NAMES")"
  printf '"plugins_skipped":%s,' "${PLUG_SKIPPED:-0}"
  printf '"plugins_skipped_names":%s,' "$(json_list "$PLUG_SKIPPED_NAMES")"
  printf '"last_update":%s,' "$(json_str "$upd")"
  printf '"crumbs":%s,' "${crumbs:-0}"
  printf '"opkg_missing":%s,' "$(json_str "$(printf '%s' "${OPKG_NEEDED:-}" | sed 's/^ //')")"
  printf '"tools_missing":%s,' "$(json_str "$(printf '%s' "$MISSING" | sed 's/^ //')")"
  dotlib_state
  printf '"dotlib":%s,' "$([ "$DOTLIB_OK" = 1 ] && echo true || echo false)"
  printf '"dotlib_source":%s,' "$(json_str "$DOTLIB_SRC")"
  printf '"dotlib_theme":%s,' "$(json_str "$DOTLIB_TH")"
  printf '"dotlib_palette":%s,' "$(json_str "$DOTLIB_PAL")"
  printf '"theme_follows":%s,' "$(json_str "fond")"
  printf '"status":%s'  "$(json_str "$([ "$rc" = 0 ] && echo ok || echo degraded)")"
  printf '}\n'
  return $rc
}

# --- Déroulé -------------------------------------------------------------------------------------
if [ "$JSON" != 1 ]; then
printf '%s%s' "$C_B" "$C_C"
cat <<'EOF'
   _   _ _
  | | | (_)_ __ ___     Configuration vim — installeur
  | | | | | '_ ` _ \
  \ \_/ / | | | | | |   Entrée = valeur par défaut, Ctrl-C = abandon
   \___/|_|_| |_| |_|
EOF
printf '%s' "$C_N"
fi
log "=== bin/install $STAMP ($*)"
if [ "$MODE" = check ] && [ "$JSON" = 1 ]; then
  # aucune sortie décorative : seulement le JSON
  { diagnose; } >/dev/null 2>&1
  print_json
  exit $?
fi
if [ "$MODE" = clean ]; then
  title "Nettoyage"
  prune_crumbs
  exit 0
fi
diagnose
if [ "$MODE" = check ] && [ "$JSON" = 1 ]; then
  print_json
  exit $?
fi

if [ "$MODE" = check ]; then
  title "Restes"
  rc=0
  crumbs=$(crumbs_list)
  if [ -n "$crumbs" ]; then
    warn "Restes détectés ($(printf '%s\n' "$crumbs" | grep -c .)) — « sh bin/install --clean » les supprime :"
    printf '%s\n' "$crumbs" | while IFS= read -r f; do [ -n "$f" ] && printf '      %s\n' "$(vim_path "$f")"; done
    rc=3
  else
    ok "Aucun reste"
  fi
  if [ "$TIER" != minimal ] && [ -z "$(ls "$REPO/plugged" 2>/dev/null)" ]; then
    warn "Aucun plugin installé"; rc=3
  fi
  has git || rc=3
  exit $rc
fi

if [ -z "$MODE" ]; then
  title "Que voulez-vous faire ?"
  choose 1 "Installer : cette configuration devient celle de vim pour $USER" \
           "Essayer : à côté de la configuration actuelle, sans rien activer" \
           "Désinstaller : restaurer la configuration précédente" \
           "Quitter"
  case $CHOICE in 1) MODE=install ;; 2) MODE=try ;; 3) MODE=uninstall ;; *) exit 0 ;; esac
fi

if [ "$MODE" != uninstall ] && [ -z "$BRANCH" ]; then
  BRANCH=$BRANCH_CUR
  list=$(branches)
  if [ "$YES" != 1 ] && [ "$(printf '%s\n' "$list" | grep -c .)" -gt 1 ]; then
    title "Quelle branche ?"
    def=1; n=1
    set --
    for b in $list; do
      [ "$b" = "$BRANCH_CUR" ] && def=$n
      set -- "$@" "$b"; n=$((n + 1))
    done
    choose "$def" "$@"
    n=1; for b in $list; do [ "$n" = "$CHOICE" ] && BRANCH=$b; n=$((n + 1)); done
  fi
fi

if [ "$MODE" != uninstall ] && [ -z "$PLUGINS" ]; then
  if [ "$TIER" = minimal ] || ! has git || { [ "$NET_HTTPS" = 0 ] && [ "$NET_SSH" = 0 ]; }; then PLUGINS=no
  elif ask "Installer / mettre à jour les plugins maintenant ?" o; then PLUGINS=yes
  else PLUGINS=no; fi
fi

if [ "$MODE" != uninstall ] && [ -n "$MISSING" ] && [ "$ENTWARE" = 0 ]; then
  title "Outils facultatifs absents"
  info "La config s'en passe ; ils ajoutent des fonctions. Commandes suggérées :"
  for t in $MISSING; do printf '    %-28s %s\n' "$t" "$(suggest "$t")"; done
fi

title "Récapitulatif"
case $MODE in
  install) info "Installer la branche $BRANCH depuis $(vim_path "$REPO")" ;;
  try) info "Essayer la branche $BRANCH sans rien activer" ;;
  uninstall) info "Retirer la configuration et restaurer la sauvegarde la plus récente" ;;
esac
[ "$MODE" = uninstall ] || info "Plugins : $PLUGINS"
ask "Continuer ?" o || { info "Abandon, rien n'a été modifié."; exit 0; }

case $MODE in
  install) do_install ;;
  try) do_try ;;
  uninstall) do_uninstall ;;
esac
log "=== fin"
